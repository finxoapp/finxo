# Auth.js session signing secret - generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials (from Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of Google account emails allowed to sign in (case-insensitive)
# Example: you@gmail.com,other@gmail.com
AUTH_ALLOWED_EMAILS=

# Canonical app URL - required by Auth.js for callback URL construction
# Set to your Vercel production URL in production; omit on previews (Auth.js uses VERCEL_URL)
AUTH_URL=http://localhost:3000
